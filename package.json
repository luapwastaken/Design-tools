{
  "name": "designtools",
  "productName": "Design Tools",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Luap's design toolbox: colour, pattern, logo, dither, halftone and post effects",
  "author": "Luap",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run check:rules",
    "check:rules": "node scripts/check-rules.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "culori": "^4.0.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "material-symbols": "^0.47.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.1.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
