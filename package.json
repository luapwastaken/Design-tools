{
  "name": "designtools",
  "version": "1.36.0",
  "description": "Design utilities",
  "author": "Luap",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.2.1",
    "concurrently": "8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "24.13.3",
    "vite": "5.4.19",
    "wait-on": "7.2.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xyflow/react": "^12.11.0",
    "colorjs.io": "^0.6.1",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "build": {
    "appId": "com.designtools.app",
    "productName": "Design Tools",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true
  }
}
